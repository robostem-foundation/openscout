<?xml version="1.0" encoding="UTF-8"?>
<!--
  The site's fixed pages, in the order they appear in the header nav.

  Event and team pages are not listed: there are tens of thousands of them and
  they are discovered by crawling /events and /teams instead. No <lastmod> is
  given anywhere here, because an inaccurate one is worse for crawling than none
  at all, and these listing pages change with every event that runs.

  <priority> is relative to this site only, and expresses the ladder we want in
  a brand search: the home page first, then the four sections.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://openscout.ing/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://openscout.ing/events</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://openscout.ing/teams</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://openscout.ing/skills</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://openscout.ing/jumper</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://openscout.ing/insights</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://openscout.ing/terms</loc>
    <changefreq>yearly</changefreq>
