# Copy to .env for local dev, and set the same keys in
# Vercel → Project Settings → Environment Variables for production.

# Required server-side secrets (never exposed to the browser)
RSE_API_KEY=
ROBOTEVENTS_API_KEY=

# Optional upstream base overrides (defaults shown)
# ROBOSTEM_API_BASE=https://robostem-api.org
# ROBOTEVENTS_API_BASE=https://events.vex.com/api/v2
# ROBOTEVENTS_ROOT_BASE=https://events.vex.com
# JUMPER_API_BASE=https://jumper.robostem.org

# Supabase (accounts). Public by design — the anon key is safe in the browser;
# security is enforced by Row Level Security. Use the SAME values locally and on
# Vercel so sessions and synced data match across environments.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase Auth URL configuration (NOT an env var — set in the project) ──────
# OAuth sign-in redirects are governed by the Supabase project's auth config, not
# by anything in this repo. The app sends redirectTo: window.location.origin (and
# window.location.href for /join/<token> deep links), but Supabase only honors a
# redirect if it matches the allow-list; otherwise it falls back to Site URL.
#
# If post-login lands on localhost in production, the Site URL is still dev. Fix:
#   Dashboard → Authentication → URL Configuration, or via the Management API:
#     site_url      = https://forge.robostem.org
#     uri_allow_list = https://forge.robostem.org/**,https://*-axcdengs-projects.vercel.app/**
#   (the /** wildcard is required so /join/<token> deep links are honored.)
#
# Do NOT use `supabase config push` for this — it treats config.toml as the full
# source of truth and would disable the Discord/Google OAuth providers. PATCH the
# two fields surgically instead:
#   curl -X PATCH -H "Authorization: Bearer $(security find-generic-password -s 'Supabase CLI' -w)" \
#     -H "Content-Type: application/json" \
#     -d '{"site_url":"https://forge.robostem.org","uri_allow_list":"https://forge.robostem.org/**,https://*-axcdengs-projects.vercel.app/**"}' \
#     https://api.supabase.com/v1/projects/<project-ref>/config/auth
